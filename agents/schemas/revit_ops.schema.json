{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revit_ops.schema.json",
  "title": "RevitOps",
  "type": "object",
  "required": ["version", "ops"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/$defs/op" }
    }
  },
  "$defs": {
    "op": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "CreateFamilyDocument",
            "CreateReferencePlane",
            "CreateParameter",
            "CreateExtrusion",
            "CreateConnector",
            "AssignMaterial",
            "CreateType",
            "SetParameterValue",
            "SaveFamily"
          ]
        },
        "args": { "type": "object" }
      }
    }
  }
}
